                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "UUID del contacto",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "772a1622-a40d-53e6-c928-668877662222"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Contacto"
